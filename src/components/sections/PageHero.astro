---
import H1 from "@components/H1.astro";
import Hr from "@components/Hr.astro";

import PageTop from "@components/paths/page-top.svg";
import PageBottom from "@components/paths/page-bottom.svg";

import bg1 from "@assets/img/bg1.jpg";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="relative">
  <img class="absolute size-full object-cover" src={bg1.src} alt="" />

  <div class="absolute top-0 size-full bg-slate-900/70"></div>

  <PageTop />

  <PageBottom />

  <div class="relative z-10 container py-60">
    <H1 className="text-white">{title}</H1>
    <Hr />
  </div>
</section>
