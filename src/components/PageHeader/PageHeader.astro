---
import Menu from "./Menu.astro";
import LangMenu from "./LangMenu.astro";

import List from "@components/icons/list.svg";

import logo from "@assets/img/sagt-logo.png";
---

<header class="fixed top-0 z-20 w-full bg-slate-900">
  <div class="container flex items-center justify-between gap-8 py-5">
    <a class="mr-auto flex items-center gap-6 lg:mr-0" href="/">
      <img class="size-16" src={logo.src} alt="Logo SAGT" />

      <span class="hidden text-center text-white 2xl:inline">
        Stowarzyszenie Absolwentów <br />
        Gdyńskiej Trójki
      </span>
    </a>

    <nav class="hidden lg:block">
      <Menu />
    </nav>

    <nav
      class="absolute top-full right-0 left-0 hidden bg-slate-900 py-10 lg:hidden"
      id="mobileMenu"
    >
      <div class="container">
        <Menu />
      </div>
    </nav>

    <LangMenu />

    <button
      class="w-10 cursor-pointer text-white lg:hidden"
      id="mobileMenuButton"
    >
      <List />
    </button>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const button = document.getElementById("mobileMenuButton");
    const menu = document.getElementById("mobileMenu");

    button.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  });
</script>
