---
import Img from "./Img.astro";
import Filler from "./Filler.astro";

interface Props {
  images: {
    src: string;
  }[];
}

const { images } = Astro.props;
---

<div class="prose max-w-none pb-32">
  <h1>Galeria zdjęć</h1>

  <div class="not-prose grid grid-cols-12 grid-rows-12 gap-5">
    <Img src={images[0].src} position="col-span-3 row-span-3" />
    <Img src={images[2].src} position="col-span-6 row-span-3" />
    <Img src={images[1].src} position="col-span-3 row-span-4" />

    <Img src={images[3].src} position="col-span-3 row-span-3" />
    <Img src={images[4].src} position="col-span-4 row-span-3" />
    <Filler bg="bg-yellow-500" position="col-span-2 row-span-1" />

    <Img src={images[5].src} position="col-span-5 row-span-3" />

    <Img src={images[7].src} position="col-span-4 row-span-3" />
    <Filler bg="bg-slate-900" position="col-span-3 row-span-1" />
    <Img src={images[8].src} position="col-span-4 row-span-3" />

    <Img src={images[9].src} position="col-span-4 row-span-3" />
    <Img src={images[10].src} position="col-span-4 row-span-3" />

    <Img src={images[11].src} position="col-span-4 row-span-3" />
    <Img src={images[6].src} position="col-span-4 row-span-3" />
  </div>
</div>
