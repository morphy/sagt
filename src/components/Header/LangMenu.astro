---
import { getRelativeLocaleUrl } from "astro:i18n";
import CaretDown from "@components/icons/caret-down.svg";

import Pl from "@components/icons/languages/pl.svg";
import En from "@components/icons/languages/gb.svg";
import De from "@components/icons/languages/de.svg";
import Es from "@components/icons/languages/es.svg";

const languages = [
  {
    code: "pl",
    name: "Polski",
    flag: Pl
  },
  {
    code: "en",
    name: "English",
    flag: En
  },
  {
    code: "de",
    name: "Deutsch",
    flag: De
  },
  {
    code: "es",
    name: "Español",
    flag: Es
  }
];

const currentLanguage = languages.find(
  (language) => language.code === Astro.currentLocale
);

const Flag = currentLanguage?.flag || (() => {});
---

<div class="relative">
  <button
    class="flex items-center gap-2 rounded-full border-2 border-solid border-yellow-500 px-5 py-2.5 font-semibold text-white duration-150 hover:bg-yellow-500 active:border-yellow-600 active:bg-yellow-600"
    id="languageMenuButton"
  >
    <div class="w-5">
      <Flag />
    </div>

    {currentLanguage?.name}

    <div class="w-6">
      <CaretDown />
    </div>
  </button>

  <ul
    class="absolute right-0 mt-5 hidden overflow-hidden rounded-lg border border-neutral-300 bg-white text-black"
    id="languageMenu"
  >
    {
      languages.map((language) => {
        const Flag = language.flag;

        return (
          <li>
            <a
              class="flex items-center gap-2 px-5 py-2.5 duration-150 hover:bg-neutral-300"
              href={getRelativeLocaleUrl(language.code)}
            >
              <div class="w-6 overflow-hidden rounded-sm shadow">
                <Flag />
              </div>

              {language.name}
            </a>
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const button = document.getElementById("languageMenuButton");
    const menu = document.getElementById("languageMenu");

    const clickAwayListener = (event) => {
      console.log("document EL fired");

      if (!event.composedPath().includes(menu)) {
        menu.classList.add("hidden");
      }
    };

    button.addEventListener("click", (event) => {
      const isHidden = menu.classList.contains("hidden");
      event.stopPropagation();

      if (isHidden) {
        menu.classList.remove("hidden");

        console.log("adding document EL");
        document.addEventListener("click", clickAwayListener, { once: true });

        return;
      }

      menu.classList.add("hidden");
      document.removeEventListener("click", clickAwayListener);
    });
  });
</script>
