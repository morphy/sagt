---
import { clsx } from "clsx";
interface Props {
  title: string;
  cols?: 2 | 3 | 4;

  cards: {
    title: string;
    subtitle?: string;
    text: string;
  }[];

  ctaTitle?: string;
  ctaSubtitle?: string;
  ctaLink?: string;
  ctaHref?: string;
  ctaWidth?: 1 | 2;
}

const {
  title,
  cols = 4,

  cards,

  ctaTitle,
  ctaSubtitle,
  ctaLink,
  ctaHref,
  ctaWidth = 2
} = Astro.props;
---

<div class="prose max-w-none pb-32">
  <h1>{title}</h1>

  <div
    class={clsx(
      ["grid", "gap-10"],
      cols === 4 ? "grid-cols-4" : cols === 3 ? "grid-cols-3" : "grid-cols-2"
    )}
  >
    {
      cards.map((card) => {
        return (
          <div class="prose flex max-w-none flex-col justify-center rounded-3xl border border-neutral-300 p-10 text-center">
            <h3> {card.title}</h3>
            <hr class="mx-auto mb-4 w-16 rounded-full border-2 border-yellow-500" />
            {card.subtitle && <h4>{card.subtitle}</h4>}
            <p>{card.text}</p>
          </div>
        );
      })
    }

    {
      ctaTitle && (
        <div
          class={clsx(
            [
              "prose",
              "flex",
              "max-w-none",
              "flex-col",
              "items-center",
              "justify-center",
              "rounded-3xl",
              "border",
              "border-neutral-300",
              "bg-slate-900",
              "p-10",
              "text-center"
            ],
            ctaWidth === 2 ? "col-span-2" : "col-span-1"
          )}
        >
          <h2 class="text-white">{ctaTitle}</h2>
          <hr class="mx-auto mb-4 w-16 rounded-full border-2 border-yellow-500" />
          <p class="text-white">{ctaSubtitle}</p>

          <a
            class="inline-block rounded-full border-2 border-solid border-yellow-500 px-5 py-2.5 font-semibold text-white no-underline duration-150 hover:bg-yellow-500 active:border-yellow-600 active:bg-yellow-600"
            href={ctaHref}
          >
            {ctaLink}
          </a>
        </div>
      )
    }
  </div>
</div>
