---
interface Props {
  title: string;
  imgSrc?: string;
}

const { title, imgSrc } = Astro.props;
---

<div class="grid grid-cols-2 gap-10 pb-32">
  <div class="prose">
    <h1>{title}</h1>
    <slot name="text" />
  </div>

  {
    imgSrc ? (
      <img
        class="size-full rounded-3xl border border-neutral-300 object-cover"
        src={imgSrc}
      />
    ) : (
      <slot name="image" />
    )
  }
</div>
