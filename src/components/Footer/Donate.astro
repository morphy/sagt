---
import H2 from "@components/H2.astro";
import Hr from "@components/Hr.astro";

import bg2 from "@assets/img/bg2.jpg";
import Paypal from "@components/icons/paypal-logo.svg";
import Bank from "@components/icons/bank.svg";
---

<section
  class="bg-cover bg-center bg-no-repeat"
  style={`background-image: url('${bg2.src}');`}
>
  <svg viewBox="0 0 1265 144" xmlns="http://www.w3.org/2000/svg">
    <path
      fill="rgba(255, 255, 255, 1)"
      d="M 0 40 C 164 40 164 20 328 20 L 328 20 L 328 0 L 0 0 Z"
      stroke-width="0"></path>
    <path
      fill="rgba(255, 255, 255, 1)"
      d="M 327 20 C 445.5 20 445.5 89 564 89 L 564 89 L 564 0 L 327 0 Z"
      stroke-width="0"></path>
    <path
      fill="rgba(255, 255, 255, 1)"
      d="M 563 89 C 724.5 89 724.5 48 886 48 L 886 48 L 886 0 L 563 0 Z"
      stroke-width="0"></path>
    <path
      fill="rgba(255, 255, 255, 1)"
      d="M 885 48 C 1006.5 48 1006.5 67 1128 67 L 1128 67 L 1128 0 L 885 0 Z"
      stroke-width="0"></path>
    <path
      fill="rgba(255, 255, 255, 1)"
      d="M 1127 67 C 1196 67 1196 0 1265 0 L 1265 0 L 1265 0 L 1127 0 Z"
      stroke-width="0"></path>
  </svg>

  <div class="container grid grid-cols-2">
    <div class="rounded-3xl bg-stone-100/85 p-12 backdrop-blur-sm">
      <H2 align="left" margin="mb-3">Wesprzyj nas!</H2>
      <Hr />

      <p class="mb-5">
        Przyznajemy stypendia dla uczniów, organizujemy cykliczne spotkania oraz
        oferujemy programy mentoringowe dzięki wsparciu osób takich jak ty!
      </p>

      <div class="mb-5 flex items-center gap-5">
        <a
          class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-5 py-2.5 font-semibold text-white duration-150 hover:bg-yellow-500 active:bg-yellow-600"
          href=""
        >
          <div class="w-5">
            <Paypal />
          </div>

          PayPal
        </a>

        <a
          class="inline-block rounded-full bg-yellow-500 px-5 py-2.5 font-semibold text-white duration-150 hover:bg-slate-900 active:bg-slate-700"
          href="/public"
        >
          1% podatku
        </a>

        <a
          class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-5 py-2.5 font-semibold text-white duration-150 hover:bg-yellow-500 active:bg-yellow-600"
          href=""
        >
          <div class="w-5">
            <Bank />
          </div>

          Przelew
        </a>
      </div>

      <p>
        Możesz też pomóc w realizacji konkretnego projektu lub
        stypendium&nbsp;—&nbsp;w takim wypadku
        <a class="underline" href="">skontaktuj się z nami</a>!
      </p>
    </div>
  </div>

  <svg
    class="relative bottom-[-1px]"
    viewBox="0 0 1265 144"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      fill="rgba(255, 255, 255, 1)"
      d="m1265 104c-164 0-164 20-328 20v20h328z"></path>
    <path
      fill="rgba(255, 255, 255, 1)"
      d="m938 124c-118 0-118-69-237-69v89h237z"></path>
    <path fill="rgba(255, 255, 255, 1)" d="m702 55c-162 0-162 41-323 41v48h323z"
    ></path>
    <path fill="rgba(255, 255, 255, 1)" d="m380 96c-122 0-122-19-243-19v67h243z"
    ></path>
    <path fill="rgba(255, 255, 255, 1)" d="m138 77c-69 0-69 67-138 67h138z"
    ></path>
  </svg>
</section>
