---
import H2 from "@components/H2.astro";
import socials from "@data/socials";
---

<div>
  <H2>Social media</H2>

  <div class="grid grid-cols-3 gap-8 px-10">
    {
      socials.map((social) => {
        const Icon = social.icon;

        return (
          <div class="flex flex-col items-center">
            <a
              class="mb-2 w-12 rounded-full bg-slate-900 p-2 text-white duration-150 hover:bg-yellow-500"
              href={social.href}
            >
              <Icon />
            </a>

            <p class="text-center">
              <span class="text-neutral-500">{social.name}</span>
              <br />
              <a class="hover:underline" href={social.href}>
                {social.value}
              </a>
            </p>
          </div>
        );
      })
    }
  </div>
</div>
