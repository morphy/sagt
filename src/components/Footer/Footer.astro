---
import Form from "./Form.astro";

import Social from "./Social.astro";
import Contact from "./Contact.astro";
import Map from "./Map.astro";
import Donate from "./Donate.astro";

import FooterBottom from "@components/paths/footer-bottom.svg";
---

<footer class="relative pb-40">
  <Donate />

  <section class="relative z-10 container grid grid-cols-2 gap-10 gap-y-40">
    <Form />

    <Map />

    <Social />

    <Contact />
  </section>

  <div class="absolute right-0 bottom-0 left-0">
    <FooterBottom />
  </div>
</footer>
