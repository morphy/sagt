---
import H2 from "@components/H2.astro";
import contact from "@data/contact.json";
---

<div>
  <div class="mx-auto max-w-4/6">
    <H2>Dane kontaktowe</H2>

    {
      contact.map((line) => (
        <>
          <p class="my-4 flex justify-between text-neutral-600">
            {line.name}
            <span>{line.value}</span>
          </p>
          <hr />
        </>
      ))
    }
  </div>
</div>
