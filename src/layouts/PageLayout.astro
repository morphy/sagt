---
import BaseLayout from "./BaseLayout.astro";
import PageHero from "@components/PageHero/PageHero.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title}>
  <PageHero title={title} />

  <section class="container">
    <slot />
  </section>
</BaseLayout>
