---
import BigProse from "@components/BigProse.astro";
import Timeline from "@components/Timeline.astro";
import BigCards from "@components/BigCards.astro";
import Gallery from "@components/Gallery/Gallery.astro";
import SmallCards from "@components/SmallCards.astro";

import spotkania from "@assets/img/spotkania.jpg";
import { Content as MainContent } from "./main.md";

import years from "./years";
import founders from "./founders";
import images from "./images";
import team from "./team";
---

<BigProse title="SAGT" imgSrc={spotkania.src}>
  <MainContent slot="text" />
</BigProse>

<Timeline points={years} />

<BigCards cards={founders} title="Założyciele" />

<SmallCards
  cards={team}
  title="Kadra"
  ctaTitle="Chcesz dołączyć do SAGT?"
  ctaSubtitle="Pomóż nam kreować Społeczność Absolwentów Gdyńskiej Trójki!"
  ctaLink="Dołącz do nas"
  ctaHref=""
/>

<Gallery images={images} />
