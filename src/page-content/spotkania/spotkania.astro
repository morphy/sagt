---
import BigProse from "@components/BigProse.astro";
import SmallCards from "@components/SmallCards.astro";

import Calendar from "./Calendar.astro";

import bg from "./bg.jpg";
import { Content as MainContent } from "./main.md";

import eventTypes from "./event-types";
import events from "./events";
---

<BigProse title="Zapraszamy na spotkania SAGT!" imgSrc={bg.src}>
  <MainContent slot="text" />
</BigProse>

<Calendar events={events} />

<SmallCards cards={eventTypes} cols={2} title="Rodzaje wydarzeń" />
