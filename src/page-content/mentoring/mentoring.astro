---
import BigProse from "@components/BigProse.astro";

import Mentors from "./Mentors.astro";
import Faq from "./Faq.astro";

import bg from "@assets/img/mentoring.jpg";
import { Content as MainContent } from "./main.md";

import mentorsPoland from "./mentors-poland";
import mentorsAbroad from "./mentors-abroad";
---

<BigProse title="Odkryj możliwości z mentoringiem SAGT" imgSrc={bg.src}>
  <MainContent slot="text" />
</BigProse>

<Mentors mentors={mentorsPoland} title="Mentorzy - Polska" />

<Mentors mentors={mentorsAbroad} title="Mentorzy - Zagranica" />

<Faq />
