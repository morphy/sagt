---
interface Props {
  title: string;

  mentors: {
    name: string;
    category: string;
    school: string[];
    experience: string;
    imgSrc: string;
  }[];
}

const { title, mentors } = Astro.props;
---

<div class="prose max-w-none pb-32">
  <h1>{title}</h1>

  <div class="flex flex-col gap-10">
    {
      mentors.map((mentor) => {
        return (
          <div class="flex items-start gap-10">
            <img
              class="not-prose aspect-square w-48 shrink-0 rounded-3xl object-cover"
              src={mentor.imgSrc}
            />

            <div class="prose flex max-w-none grow flex-col rounded-3xl border border-neutral-300 p-10">
              <h3>{mentor.name}</h3>

              <hr class="mb-4 w-16 rounded-full border-2 border-yellow-500" />

              <h4>{mentor.category}</h4>
              <p>{mentor.experience}</p>
              <ul class="mt-0">
                {mentor.school.map((entry) => (
                  <li>{entry}</li>
                ))}
              </ul>
            </div>
          </div>
        );
      })
    }
  </div>
</div>
