---
import Timeline from "@components/Timeline.astro";
import BigCards from "@components/BigCards.astro";
import SmallCards from "@components/SmallCards.astro";
import BigProse from "@components/BigProse.astro";
import Partners from "@components/Partners/Partners.astro";

import { Content as MainContent } from "./main.md";

import stats from "./stats";
import scholarships from "./scholarships";
import awardees from "./awardees";
---

<BigProse title="Stypendia SAGT">
  <MainContent slot="text" />
  <Fragment slot="image">
    <Partners />
  </Fragment>
</BigProse>

<Timeline points={stats} />

<BigCards cards={scholarships} title="Stypendia i nagrody" />

<SmallCards
  cards={awardees}
  title="Sylwetki stypendystów"
  ctaTitle="Chcesz otrzymać stypendium?"
  ctaSubtitle="Zgłoś się do programu stypendialnego!"
  ctaLink="Napisz do nas"
  ctaHref=""
  ctaWidth={1}
/>
