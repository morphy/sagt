---
import actions from "@data/actions";
---

<section class="container pb-40">
  <h2 class="mb-5">Nasze działania</h2>
  <hr class="mb-12" />

  <div class="grid grid-cols-3 gap-10">
    {
      actions.map((action) => (
        <div class="flex flex-col overflow-hidden rounded-3xl border border-neutral-300">
          <img src={action.img.src} alt="" />

          <div class="flex grow flex-col p-5">
            <h3 class="mb-2 text-2xl font-medium">{action.name}</h3>

            <hr class="mb-5" />

            <p class="mb-6">{action.description}</p>

            <a
              class="mt-auto ml-auto inline-block rounded-full bg-slate-900 px-5 py-2.5 font-semibold text-white duration-150 hover:bg-yellow-500 active:border-yellow-600 active:bg-yellow-600"
              href={action.href}
            >
              Więcej
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>
